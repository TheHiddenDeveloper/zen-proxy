  "//": "Alternative to the claude-ox launcher: put this in a project's .claude/settings.local.json and run plain `claude` there. Start zen-proxy first.",
  "env": {
    "ANTHROPIC_BASE_URL": "http://127.0.0.1:4040",
    "ANTHROPIC_AUTH_TOKEN": "zen-proxy",
